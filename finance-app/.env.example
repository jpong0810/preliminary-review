DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Supabase/Neon give you two connection strings — a pooled one (DATABASE_URL, used at
# runtime) and a direct one (DIRECT_URL, used only for running migrations).
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Private bearer token the MCP server requires on every request (Authorization: Bearer <token>)
MCP_API_KEY="generate-a-long-random-secret"

# Server-side only. Powers the in-app quick-add auto-tagging/sentiment/ticker-price inference
# endpoint (/api/ai/infer-thought) so it works even without an open Claude conversation.
ANTHROPIC_API_KEY=""
